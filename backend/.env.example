# Copy to .env and adjust for the local/production environment.
# Settings are read from the directory where the app is launched.

# --- Application -------------------------------------------------------
APP_ENV=development
DEBUG=true

# --- Security ----------------------------------------------------------
# IMPORTANT: generate a long random value for production, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12

# --- Database ----------------------------------------------------------
# SQLite (default)
DATABASE_URL=sqlite:///./bahraini28.db
# PostgreSQL (production) example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/bahraini28
DB_ECHO=false

# --- Business rules ----------------------------------------------------
DEFAULT_TIMEZONE=Asia/Bahrain
DAILY_LIMIT_PER_BUSINESS=3

# --- CORS --------------------------------------------------------------
# JSON list of allowed frontend origins (Vite defaults included).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000"]

# --- Bootstrap ---------------------------------------------------------
SEED_DEFAULT_ADMIN=true
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=admin123