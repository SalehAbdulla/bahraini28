# Bahraini 28 — Caddy v2 configuration.
#
# - Serves the built SPA from the shared `dist_data` volume (mounted at /srv)
# - Proxies /api, /uploads and the SSE admin notification feed to the backend
# - Automatic HTTPS via Let's Encrypt for the configured site domain

{
	admin off
	{$SITE_TLS_EMAIL_OPTION}
}

{$SITE_DOMAIN:bahraini28.com}, www.{$SITE_DOMAIN:bahraini28.com} {
	encode zstd gzip
	root * /srv

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-X-Server
	}

	# API + uploads first. `handle` blocks are mutually exclusive and evaluated
	# in the order written, so try_files can never rewrite an /api path to
	# /index.html (Caddy's fixed directive order puts try_files *before*
	# reverse_proxy, which would otherwise break every API call).
	handle /health {
		reverse_proxy backend:8000
	}
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /uploads/* {
		reverse_proxy backend:8000
	}
	# Everything else is the SPA. `file_server` is required — `root` + try_files
	# alone serve nothing (Caddy answers 200 with an empty body).
	handle {
		try_files {path} /index.html
		file_server
	}
}
