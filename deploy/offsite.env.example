# Bahraini 28 — off-site backup configuration.
#
# Copy to deploy/offsite.env (git-ignored) and point it at storage that is NOT
# this host. deploy/offsite-backup.sh reads it on every run; environment
# variables take precedence (handy for a one-off or a CI check).
#
#   sudo install -m 600 deploy/offsite.env /opt/bahraini28/deploy/offsite.env
#
# First-time setup (Oracle Object Storage — free tier, recommended):
#   sudo apt install -y rclone          # or: curl https://rclone.org/install.sh | sudo bash
#   # create the bucket "bahraini28-backups" in the OCI console (your home region)
#   sudo mkdir -p /root/.config/rclone
#   sudo install -m 600 deploy/rclone-oci.conf /root/.config/rclone/rclone.conf
#   rclone lsd oci:                     # should print the bucket
#   sudo ./deploy/offsite-backup.sh --dry-run
#
#   deploy/rclone-oci.conf.example ships all three auth flavours — the instance
#   principal needs no keys on the host, and the S3-compatible one uses Customer
#   Secret Keys. Any other rclone remote works too; just set OFFSITE_REMOTE below.
# ---------------------------------------------------------------------------

# Where the backups go. Any rclone destination works:
#   oci:bahraini28-backups     Oracle Object Storage (free tier; see rclone-oci.conf.example)
#   s3:bahraini28-backups      AWS S3 (me-south-1 keeps the data in Bahrain)
#   b2:bahraini28-backups      Backblaze B2
#   /mnt/backup-usb            a mounted disk or NFS share on another host
OFFSITE_REMOTE=

# The rclone config holding the remote's credentials. Defaults to the user's
# ~/.config/rclone/rclone.conf — i.e. root's, when cron runs as root.
#RCLONE_CONFIG=/root/.config/rclone/rclone.conf

# Optional: where deploy/backup.sh wrote the artifacts.
#BACKUP_DIR=/var/backups/bahraini28

# Optional: repo location (deploy.sh assumes /opt/bahraini28).
#BAHRAINI28_DIR=/opt/bahraini28
