# Bahraini 28 - Caddy v2 configuration for the CO-HOSTED deploy.
#
# Unlike deploy/Caddyfile this one does NOT do ACME. beyond-nginx terminates TLS
# for bahraini28.com and proxies here over the shared `beyond-prod` network, so
# the site address is a bare `:80` (no hostname): Caddy serves plain HTTP for
# whatever Host the edge forwards and never attempts a certificate.
#
# Selected by deploy/docker-compose.cohost.yml (mounted at /etc/caddy/Caddyfile).

{
	admin off
}

:80 {
	encode zstd gzip
	root * /srv

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-X-Server
	}

	# API + uploads first. `handle` blocks are mutually exclusive and evaluated
	# in the order written, so try_files can never rewrite an /api path to
	# /index.html (Caddy's fixed directive order puts try_files *before*
	# reverse_proxy, which would otherwise break every API call).
	handle /health {
		reverse_proxy backend:8000
	}
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /uploads/* {
		reverse_proxy backend:8000
	}
	# Everything else is the SPA. `file_server` is required - `root` + try_files
	# alone serve nothing (Caddy answers 200 with an empty body).
	handle {
		try_files {path} /index.html
		file_server
	}
}
