# Bahraini 28 — production environment template.
# Copy to deploy/.env (deploy.sh does this automatically and generates the
# secrets). NEVER commit .env — it is gitignored.
#
# PostgreSQL password: use alphanumeric characters only so it stays valid
# inside the DATABASE_URL above without URL-encoding.

# --- Site / TLS ------------------------------------------------------------
SITE_DOMAIN=bahraini28.com
# Optional Caddy global option line, e.g. "email admin@example.com".
# Leave empty for Caddy's default Let's Encrypt contact.
SITE_TLS_EMAIL_OPTION=

# --- PostgreSQL (docker-compose service "postgres") ------------------------
POSTGRES_USER=bahraini28
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=bahraini28

# --- FastAPI backend -------------------------------------------------------
APP_ENV=production
DEBUG=false
# Generate with: openssl rand -hex 32  (deploy.sh fills this automatically)
SECRET_KEY=CHANGE_ME_64_RANDOM_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BCRYPT_ROUNDS=12
# Host is the compose service name "postgres", not "localhost".
DATABASE_URL=postgresql+psycopg://bahraini28:CHANGE_ME_STRONG_PASSWORD@postgres:5432/bahraini28
DB_ECHO=false

# --- Business rules --------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Bahrain
DAILY_LIMIT_PER_BUSINESS=3

# --- Assets ----------------------------------------------------------------
# Backed by the `uploads` named volume (persistent).
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=2

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=["https://bahraini28.com","https://www.bahraini28.com"]

# --- Bootstrap -------------------------------------------------------------
# Keep true for the very first boot so the initial admin is created, then
# change the admin password and set SEED_DEFAULT_ADMIN=false permanently.
SEED_DEFAULT_ADMIN=true
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_INITIAL_NAME=System Administrator
