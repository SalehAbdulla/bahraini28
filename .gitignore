# --- Environment & secrets -------------------------------------------------
.env
*.env.local
# Off-site backup config: names a bucket and may point at an rclone config.
deploy/offsite.env

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Database -----------------------------------------------------------------
*.db
*.sqlite3

# --- Backend uploads ----------------------------------------------------------
# Business logos are runtime data, never committed. This ignores any `uploads`
# directory at any depth (covers `backend/uploads` and stray nested dirs such as
# `backend/backend/uploads` created when the API/tests run from a different
# working directory).
uploads/

# --- Node.js / Vite -----------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
*.local

# --- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Original source assets (tracking not desired) ----------------------------
# Anchored on purpose. A bare `Brand/` also matched `frontend/public/brand/`
# (git applies core.ignorecase when matching ignore rules), which silently kept
# the brand assets the app actually serves out of every commit.
/docs/Fonts.zip
/docs/Bahraini 28 3.pdf
/Brand/
# The elite-card sheet and the A3 poster deck the partner seed and its logos
# were extracted from (a 16 MB print-ready PDF): provenance, not something the
# app serves, and the script says so.
/data/

# --- Playwright / E2E ----------------------------------------------------------
e2e/test-results/
e2e/playwright-report/
